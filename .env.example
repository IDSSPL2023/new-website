# Public browser endpoints only. Never place the OpenAI API key in a VITE_ variable.
VITE_CHATBOT_ENDPOINT=https://your-chatbot-lambda-url.lambda-url.ap-south-1.on.aws/
# Primary endpoint used by both Contact Us and Download Brochure lead forms.
VITE_LEAD_ENDPOINT=https://your-lead-lambda-url.lambda-url.ap-south-1.on.aws/
# Backward-compatible alias; VITE_LEAD_ENDPOINT takes precedence.
VITE_BROCHURE_LEAD_ENDPOINT=https://your-lead-lambda-url.lambda-url.ap-south-1.on.aws/
