# Local server-only settings. Copy into .env.local (ignored by Git).
# Public visitors use the approved IDSSPL knowledge bundled with the website.
# It requires no AI API key or paid chatbot endpoint.
# Ollama is optional and used only while developing on this computer.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
# Reserved for an optional future lead-submission service. Public chat replies do not use it.
VITE_CHATBOT_ENDPOINT=
# Primary endpoint used by both Contact Us and Download Brochure lead forms.
VITE_LEAD_ENDPOINT=https://your-lead-lambda-url.lambda-url.ap-south-1.on.aws/
# Backward-compatible alias; VITE_LEAD_ENDPOINT takes precedence.
VITE_BROCHURE_LEAD_ENDPOINT=https://your-lead-lambda-url.lambda-url.ap-south-1.on.aws/
